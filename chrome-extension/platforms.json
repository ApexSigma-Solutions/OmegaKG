{
  "Claude.ai": {
    "hostnames": ["claude.ai"],
    "messages": [".font-user-message", ".font-claude-response", "[data-test-id='conversation-turn']"],
    "isUser": ["class:font-user-message", "closest:[data-testid*='user']", "attr:data-is-user=true"],
    "getText": ["selector:[class*='font-claude-message']", "selector:div[class*='whitespace-pre-wrap']", "textContent"]
  },
  "ChatGPT": {
    "hostnames": ["openai.com", "chatgpt.com"],
    "messages": ["[data-message-author-role]", "div[data-message-author-role]", "article"],
    "isUser": ["attr:data-message-author-role=user", "closest:[data-testid*='user']"],
    "getText": ["selector:.markdown", "textContent"]
  },
  "Gemini": {
    "hostnames": ["gemini.google.com"],
    "messages": [
      "message-content",
      ".message-content",
      "[data-test-id='user-query']",
      "[data-test-id='model-response']",
      "user-query",
      "model-response"
    ],
    "isUser": [
      "attr:data-test-id=user-query",
      "class:user-query",
      "closest:user-query"
    ],
    "getText": ["textContent"]
  },
  "AI_Studio": {
    "hostnames": ["aistudio.google.com"],
    "messages": ["[class*='message']", "[class*='response']", "[class*='prompt']"],
    "isUser": ["text:user:", "text:you:", "closest:[class*='user']", "closest:[data-role='user']"],
    "getText": ["textContent"]
  },
  "Perplexity": {
    "hostnames": ["perplexity.ai"],
    "messages": ["[class*='Markdown']", ".prose", "[data-testid='thread-message']"],
    "isUser": ["closest:[class*='UserMessage']", "closest:[class*='Query']", "attr:data-role=user"],
    "getText": ["textContent"]
  },
  "GitHub_Copilot": {
    "hostnames": ["github.com"],
    "urlContains": "copilot",
    "messages": ["[class*='message']"],
    "isUser": ["closest:[class*='user']"],
    "getText": ["textContent"]
  },
  "Nano_GPT": {
    "hostnames": ["nano-gpt.com"],
    "messages": ["div.whitespace-pre-wrap", "[class*='message']", "[class*='chat']"],
    "isUser": ["closest:[class*='user']", "closest:[data-role='user']"],
    "getText": ["textContent"]
  },
  "Qwen": {
    "hostnames": ["qwen.ai", "tongyi.aliyun.com"],
    "messages": ["[class*='message']", "[class*='chat-message']"],
    "isUser": ["closest:[class*='user']", "attr:data-role=user"],
    "getText": ["textContent"]
  },
  "DeepSeek": {
    "hostnames": ["deepseek.com"],
    "messages": ["[class*='message']", "[class*='conversation']"],
    "isUser": ["closest:[class*='user']", "attr:data-role=user"],
    "getText": ["textContent"]
  },
  "Mistral": {
    "hostnames": ["mistral.ai"],
    "messages": ["[class*='message']", "[class*='chat']"],
    "isUser": ["closest:[class*='user']"],
    "getText": ["textContent"]
  }
}