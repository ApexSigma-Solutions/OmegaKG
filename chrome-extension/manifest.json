{
  "manifest_version": 3,
  "name": "Omega_KG Chat Capture",
  "version": "2.1.0",
  "description": "Captures AI conversations to Obsidian/Neo4j knowledge graph (10+ platforms)",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://nano-gpt.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://github.com/*",
    "https://chat.qwen.ai/*",
    "https://tongyi.aliyun.com/*",
    "https://chat.z.ai/*",
    "https://www.kimi.com/*",
    "https://kimi.moonshot.cn/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "http://localhost:8002/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://nano-gpt.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://github.com/*",
        "https://chat.qwen.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://chat.z.ai/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Omega_KG: Capture AI Conversations",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
