{
  "Claude.ai": {
    "hostnames": ["claude.ai"],
    "messages": [".font-user-message", ".font-claude-response"],
    "isUser": ["class:font-user-message", "closest:[data-testid*='user']"],
    "getText": ["selector:[class*='font-claude-message']", "selector:div[class*='whitespace-pre-wrap']", "textContent"]
  },
  "ChatGPT": {
    "hostnames": ["openai.com", "chatgpt.com"],
    "messages": ["[data-message-author-role]"],
    "isUser": ["attr:data-message-author-role=user"],
    "getText": ["textContent"]
  },
  "AI_Studio": {
    "hostnames": ["aistudio.google.com"],
    "messages": ["[class*='message']", "[class*='response']", "[class*='prompt']"],
    "isUser": ["text:user:", "text:you:", "closest:[class*='user']", "closest:[data-role='user']"],
    "getText": ["textContent"]
  },
  "Nano_GPT": {
    "hostnames": ["nano-gpt.com"],
    "messages": ["div.whitespace-pre-wrap", "[class*='message']", "[class*='chat']"],
    "isUser": ["closest:[class*='user']", "closest:[data-role='user']"],
    "getText": ["textContent"]
  },
  "Gemini": {
    "hostnames": ["gemini.google.com"],
    "messages": ["user-query", "message-content"],
    "isUser": ["tag:user-query"],
    "getText": ["selector:.markdown", "selector:[class*='markdown']", "textContent"]
  },
  "Perplexity": {
    "hostnames": ["perplexity.ai"],
    "messages": ["[class*='Markdown']", ".prose"],
    "isUser": ["closest:[class*='UserMessage']", "closest:[class*='Query']"],
    "getText": ["textContent"]
  },
  "GitHub_Copilot": {
    "hostnames": ["github.com"],
    "urlContains": "copilot",
    "messages": ["[class*='message']"],
    "isUser": ["closest:[class*='user']"],
    "getText": ["textContent"]
  },
  "Qwen": {
    "hostnames": ["qwen.ai", "tongyi.aliyun.com"],
    "messages": ["[class*='message']", "[class*='chat-message']"],
    "isUser": ["closest:[class*='user']", "attr:data-role=user"],
    "getText": ["textContent"]
  },
  "Z.ai": {
    "hostnames": ["z.ai"],
    "messages": ["[class*='message']", "[role='article']"],
    "isUser": ["closest:[class*='user']"],
    "getText": ["textContent"]
  },
  "Kimi": {
    "hostnames": ["kimi.com", "kimi.moonshot"],
    "messages": ["[class*='message']", "[class*='chat']"],
    "isUser": ["closest:[class*='user']"],
    "getText": ["textContent"]
  },
  "DeepSeek": {
    "hostnames": ["deepseek.com"],
    "messages": ["[class*='message']", "[class*='conversation']"],
    "isUser": ["closest:[class*='user']", "attr:data-role=user"],
    "getText": ["textContent"]
  },
  "Mistral": {
    "hostnames": ["mistral.ai"],
    "messages": ["[class*='message']", "[class*='chat']"],
    "isUser": ["closest:[class*='user']"],
    "getText": ["textContent"]
  }
}