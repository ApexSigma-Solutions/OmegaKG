# =============================================================================
# OMEGA_KG ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the actual values.
# See docs/PORT_MAPPING.md for port assignments.
#
# =============================================================================
# ZERO TRUST SECURITY (HYBRID MODE)
# =============================================================================
# Enforce dynamic secret loading from Bitwarden (recommended). Tests can disable
# this in .env.test.
ZERO_TRUST_REQUIRED=true

# OPTION A: ZERO TRUST (RECOMMENDED)
# Set this token to inject secrets directly from Bitwarden at runtime.
# If set, the app will ignore local secret variables and fetch them securely.
# BWS_ACCESS_TOKEN=<place_your_machine_account_token_here>

# Bitwarden Secret IDs (Map these to UUIDs in your Bitwarden Project)
# The app looks for these IDs if BWS_ACCESS_TOKEN is present.
LINEAR_WEBHOOK_SECRET_PRD_ID=<uuid>
POSTGRES_PASSWORD_PRD_ID=<uuid>
NEO4J_PASSWORD_PRD_ID=<uuid>
EXTENSION_API_KEY_PRD_ID=<uuid>
LINEAR_API_KEY_PRD_ID=<uuid>
PERPLEXITY_API_KEY_PRD_ID=<uuid>
GEMINI_API_KEY_PRD_ID=<uuid>
NANOGPT_OMEGAKG_API_KEY=<uuid>
JWT_SECRET_KEY_ID=<uuid>
OLLAMA_OKG_API_KEY_PRD_ID=<uuid>

# =============================================================================
# OPTION B: LEGACY / LOCAL OVERRIDE
# =============================================================================
# If BWS_ACCESS_TOKEN is not set, the app falls back to these plain-text values.

# =============================================================================
# PROJECT INFO
# =============================================================================
PROJECT_NAME=Omega KG
VERSION=4.4.2

# =============================================================================
# SERVER SETTINGS
# =============================================================================
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765

# =============================================================================
# INFRASTRUCTURE (POSTGRES - REQUIRED)
# =============================================================================
POSTGRES_USER=omega_user
POSTGRES_DB=omega_kg
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_PASSWORD=omega_dev_password

# Docker-internal routing (used by docker-compose services)
POSTGRES_SERVER_DOCKER=postgres-db
POSTGRES_PORT_DOCKER=5432
POSTGRES_SERVER_DOCKER_DEV=postgres-dev
POSTGRES_PORT_DOCKER_DEV=5432

# =============================================================================
# INFRASTRUCTURE (REDIS - OPTIONAL FOR PRODUCTION RATE LIMITING)
# =============================================================================
# Use Redis for distributed rate limiting across multiple server processes.
# If not set, falls back to in-memory rate limiting (suitable for single-process development).
# Production deployment: REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Docker-internal routing (used by docker-compose services)
# REDIS_HOST_DOCKER=redis-cache
# REDIS_PORT_DOCKER=6379

# =============================================================================
# INFRASTRUCTURE (NEO4J - REQUIRED)
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_secure_password
NEO4J_HEAP_SIZE=512M
NEO4J_HOST_DATA_PATH=./data/neo4j

# Docker-internal routing (used by docker-compose services)
NEO4J_URI_DOCKER=bolt://neo4j-db:7687
NEO4J_URI_DOCKER_DEV=bolt://neo4j-dev:7687

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
JWT_SECRET_KEY=change_me_to_secure_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# API key for browser extension authentication
EXTENSION_API_KEY_PRD=change_me_secure_api_key
# Chrome extension ID for CORS configuration
CHROME_EXTENSION_ID=your_chrome_extension_id

# =============================================================================
# EMAIL/SMTP (Optional)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_TO=recipient@example.com

# =============================================================================
# EXTERNAL SERVICES - LINEAR
# =============================================================================
LINEAR_API_KEY=lin_api_placeholder
LINEAR_TEAM_ID=your_team
LINEAR_WORKSPACE_ID=your_workspace
LINEAR_PROJECT_ID=your_project
LINEAR_WEBHOOK_SECRET=lin_wh_placeholder

# JSON Maps for Linear Parsing (optional)
LINEAR_STATUS_MAP_JSON={"in-progress": "state-id", "done": "state-id-2"}
LINEAR_USER_MAP_JSON={}
LINEAR_LABEL_MAP_JSON={}

# =============================================================================
# EXTERNAL SERVICES - GITHUB
# =============================================================================
GITHUB_TOKEN=github_pat_placeholder

# =============================================================================
# EMBEDDING SERVICE (CRITICAL - REQUIRED)
# =============================================================================
# Provider: ollama (local), nanogpt (fallback), gemini (secondary), mock (dev)
EMBEDDING_PROVIDER=ollama
# Ollama Base URL - must match the host where Ollama is running
OLLAMA_BASE_URL=http://0.0.0.0:11434

# =============================================================================
# AI SERVICES
# =============================================================================
# NanoGPT API key (used for AI text generation and embeddings)
NANOGPT_OMEGAKG_API_KEY=your_nanogpt_api_key
# OpenRouter API key (required for routing AI requests)
OPENROUTER_API_KEY=sk-or-v1-placeholder
# Perplexity API key (used for querying Perplexity AI)
PERPLEXITY_API_KEY_PRD=pplx-placeholder
# Gemini API key (required for Google Gemini LLM integration)
GEMINI_API_KEY_PRD=AIza-placeholder
# Ollama API key ID (for Ollama embedding service)
OLLAMA_OKG_API_KEY_PRD_ID=<uuid>

# =============================================================================
# QUIPU MONITORING (OLLAMA HEARTBEAT)
# =============================================================================
# Ollama host URL for heartbeat monitoring (defaults to OLLAMA_BASE_URL if not set)
OLLAMA_HOST_URL=http://localhost:11434
# Heartbeat check interval in seconds
HEARTBEAT_INTERVAL_SEC=60
# Service identifier for heartbeat records
QUIPU_SERVICE_NAME=ollama-server-01
# Legacy: Direct PostgreSQL connection string (overrides postgres_* fields if set)
OMEGA_PG_CONN=postgresql://user:password@localhost:5432/omega_datalake

# =============================================================================
# LOGIC & KEYWORDS
# =============================================================================
DECISION_KEYWORDS=decided to,chose to,agreed to

# =============================================================================
# CONVERSATION DATALAKE SETTINGS
# =============================================================================

# =============================================================================
# PERCOLATION ENGINE CONFIGURATION
# =============================================================================
# Similarity threshold for creating relationships in the percolation engine (0.0-1.0)
PERCOLATION_SIMILARITY_THRESHOLD=0.8

# =============================================================================
# PATHS
# =============================================================================
OBSIDIAN_VAULT_PATH=./vault
AI_CONVERSATIONS_PATH=./vault/AI_Conversations
