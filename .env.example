# =============================================================================
# ZERO TRUST SECURITY (HYBRID MODE)
# =============================================================================
# OPTION A: ZERO TRUST (RECOMMENDED)
# Set this token to inject secrets directly from Bitwarden at runtime.
# If set, the app will ignore local secret variables and fetch them securely.
# BWS_ACCESS_TOKEN= <place_your_machine_account_token_here>

# Bitwarden Secret IDs (Map these to UUIDs in your Bitwarden Project)
# The app looks for these IDs if BWS_ACCESS_TOKEN is present.
LINEAR_WEBHOOK_SECRET_ID=<uuid>
POSTGRES_PASSWORD_ID=<uuid>
NEO4J_PASSWORD_ID=<uuid>
LINEAR_API_KEY_ID=<uuid>
PERPLEXITY_API_KEY_ID=<uuid>
GEMINI_API_KEY_ID=<uuid>
NGROK_API_KEY_ID=<uuid>
NANOGPT_DEV_API_KEY_ID=<uuid>

# OPTION B: LEGACY / LOCAL OVERRIDE
# If BWS_ACCESS_TOKEN is not set, the app falls back to these plain-text values.
# LINEAR_WEBHOOK_SECRET=change_me_to_secure_random_string
# POSTGRES_PASSWORD=omega_dev_password

# =============================================================================
# INFRASTRUCTURE (POSTGRES - REQUIRED)
# =============================================================================
# Standard Dev Config (Matches docker-compose.yml)
POSTGRES_USER=omega_user
POSTGRES_DB=omega_kg
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433 
# Note: 5433 is used in Dev to avoid conflict with Stable (5432)

# =============================================================================
# SERVER SETTINGS
# =============================================================================
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8005
# Note: 8005 is used in Dev to avoid conflict with Stable (8002/8000)

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Linear Integration
# LINEAR_API_KEY=lin_api_placeholder
LINEAR_TEAM_ID=ApexSigma
LINEAR_WORKSPACE_ID=ApexSigma-Solutions
LINEAR_PROJECT_ID=Omega_KG

# AI Services
# OPENROUTER_API_KEY=sk-or-v1-placeholder
# PERPLEXITY_API_KEY=placeholder
# GEMINI_API_KEY=placeholder

# =============================================================================
# LEGACY / STABLE INFRASTRUCTURE (NEO4J)
# =============================================================================
# Kept for compatibility with legacy graph modules
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_PASSWORD is handled via Bitwarden or fallback above
NEO4J_HEAP_SIZE=512M
NEO4J_HOST_DATA_PATH=./data/neo4j

# =============================================================================
# PATHS
# =============================================================================
OBSIDIAN_VAULT_PATH=./vault