# Example environment variables for Omega_KG
# Copy this file to .env and fill in the actual values

# APP_ENV can be 'development' or 'production'
APP_ENV=development
# Neo4j connection URI (format: bolt://host:port)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password
# Absolute or relative path to your Obsidian vault directory
OBSIDIAN_VAULT_PATH=./vault

# Email settings (optional; only required for lifecycle email notifications)
# If you want to receive lifecycle reports via email, fill in the following:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=username@gmail.com
EMAIL_TO=username@gmail.com
# LINEAR_API_KEY is required for Linear integration (see integration points in documentation)
LINEAR_API_KEY=your-linear-api-key
# Linear webhook secret
LINEAR_API_KEY=your-linear-api-key
# Linear webhook secret
LINEAR_WEBHOOK_SECRET=your-linear-webhook-secret
# Linear team ID
LINEAR_TEAM_ID=your-linear-team-id
# Linear workspace ID
LINEAR_WORKSPACE_ID=your-linear-workspace-id
# Linear project ID
LINEAR_PROJECT_ID=your-linear-project-id
# GitHub token
GITHUB_TOKEN=your-github-token

# NanoGPT API key (used for AI text generation in omega_kg/percolation.py and related modules)
NANOGPT_API_KEY=your-nanogpt-api-key

# OpenRouter API key (required for routing AI requests in omega_kg modules that support multiple LLM providers)
OPENROUTER_API_KEY=your-openrouter-api-key

# Perplexity API key (used for querying Perplexity AI in modules that support external LLMs)
PERPLEXITY_API_KEY=your-perplexity-api-key

# Gemini API key (required for Google Gemini LLM integration in omega_kg modules)
GEMINI_API_KEY=your-gemini-api-key
