# Example environment variables for Omega_KG
# Copy this file to .env and fill in the actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# APP_ENV can be 'development' or 'production'
APP_ENV=development

# =============================================================================
# NEO4J DATABASE
# =============================================================================
# Neo4j connection URI (format: bolt://host:port)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password
NEO4J_HEAP_SIZE=512M

# =============================================================================
# OBSIDIAN INTEGRATION
# =============================================================================
# Absolute or relative path to your Obsidian vault directory
OBSIDIAN_VAULT_PATH=./vault

# =============================================================================
# SECURITY SETTINGS (REQUIRED)
# =============================================================================
# API key for browser extension authentication (generate a secure random string)
EXTENSION_API_KEY=your-secure-api-key-here

# Secret for verifying Linear webhook payloads (generate a secure random string)
LINEAR_WEBHOOK_SECRET=your-webhook-secret-here

# Chrome extension ID for CORS configuration (get from chrome://extensions/)
CHROME_EXTENSION_ID=your-chrome-extension-id-here

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
# JWT secret key for signing tokens (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your_new_long_random_64_char_secret_key_here

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration time in minutes (default: 1440 = 24 hours)
JWT_EXPIRATION_MINUTES=1440
SMTP_PORT=587
SMTP_USER=username@gmail.com
SMTP_PASSWORD=your-smtp-password
EMAIL_TO=username@gmail.com

# =============================================================================
# LINEAR INTEGRATION
# =============================================================================
# Linear API key (required for Linear integration)
LINEAR_API_KEY=your-linear-api-key
# Linear team ID
LINEAR_TEAM_ID=your-linear-team-id
# Linear workspace ID
LINEAR_WORKSPACE_ID=your-linear-workspace-id
# Linear project ID
LINEAR_PROJECT_ID=your-linear-project-id

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# GitHub token
GITHUB_TOKEN=your-github-token

# =============================================================================
# AI SERVICES
# =============================================================================
# NanoGPT API key (used for AI text generation)
NANOGPT_API_KEY=your-nanogpt-api-key
# OpenRouter API key (required for routing AI requests)
OPENROUTER_API_KEY=your-openrouter-api-key
# Perplexity API key (used for querying Perplexity AI)
PERPLEXITY_API_KEY=your-perplexity-api-key
# Gemini API key (required for Google Gemini LLM integration)
GEMINI_API_KEY=your-gemini-api-key

# =============================================================================
#SECURITY 
# A secret key your Chrome extension must send in the 'X-API-Key' header
# to authenticate requests to the Omega_KG backend. 
# =============================================================================
OMEGA_API_KEY="your-secret-key-here"