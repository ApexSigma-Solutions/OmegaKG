# Example environment variables for Omega_KG
# Copy this file to .env and fill in the actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# APP_ENV can be 'development' or 'production'
APP_ENV=development

# =============================================================================
# NEO4J DATABASE
# =============================================================================
# Neo4j connection URI (format: bolt://host:port)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password

# =============================================================================
# OBSIDIAN INTEGRATION
# =============================================================================
# Absolute or relative path to your Obsidian vault directory
OBSIDIAN_VAULT_PATH=./vault

# =============================================================================
# EMAIL SETTINGS (Optional)
# =============================================================================
# Email settings for lifecycle reports (optional; only required for lifecycle email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=username@gmail.com
SMTP_PASSWORD=your-smtp-password
EMAIL_TO=username@gmail.com

# =============================================================================
# LINEAR INTEGRATION
# =============================================================================
# Linear API key (required for Linear integration)
LINEAR_API_KEY=your-linear-api-key
# Linear webhook secret
LINEAR_WEBHOOK_SECRET=your-linear-webhook-secret
# Linear team ID
LINEAR_TEAM_ID=your-linear-team-id
# Linear workspace ID
LINEAR_WORKSPACE_ID=your-linear-workspace-id
# Linear project ID
LINEAR_PROJECT_ID=your-linear-project-id

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# GitHub token
GITHUB_TOKEN=your-github-token

# =============================================================================
# AI SERVICES
# =============================================================================
# NanoGPT API key (used for AI text generation)
NANOGPT_API_KEY=your-nanogpt-api-key
# OpenRouter API key (required for routing AI requests)
OPENROUTER_API_KEY=your-openrouter-api-key
# Perplexity API key (used for querying Perplexity AI)
PERPLEXITY_API_KEY=your-perplexity-api-key
# Gemini API key (required for Google Gemini LLM integration)
GEMINI_API_KEY=your-gemini-api-key
