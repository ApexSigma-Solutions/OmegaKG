NEO4J_USER=neo4j
NEO4J_PASSWORD=test-password
NEO4J_HEAP_SIZE=512M
POSTGRES_USER=omega_user
POSTGRES_PASSWORD=omega_dev_password
POSTGRES_DB=omega_kg
OBSIDIAN_VAULT_PATH=./dev_vault

# Dev-specific resource names / host ports to avoid touching stable stack
NEO4J_CONTAINER_NAME=omega_kg_neo4j_dev
NEO4J_VOLUME_NAME=omega_kg_neo4j_dev_data
NEO4J_HTTP_HOST_PORT=7475
NEO4J_BOLT_HOST_PORT=7689

POSTGRES_CONTAINER_NAME=omega_kg_postgres_dev
POSTGRES_VOLUME_NAME=omega_kg_postgres_dev_data
POSTGRES_HOST_PORT=15432
